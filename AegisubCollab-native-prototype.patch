+        run: |
+          g++ -std=c++20 -Wall -Wextra -Werror $(wx-config --cxxflags base,net) -DwxUSE_GUI=0 src/collaboration/document.cpp tests/collaboration_transport.cpp $(wx-config --libs base,net) -o /tmp/collaboration-transport
